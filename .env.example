# ---------------------------------------------------------------------------
# Scholaris backend configuration
# Copy this file to `.env` (same folder) and fill in only what you have.
# The app starts and works with everything blank.
# ---------------------------------------------------------------------------

# Used by OpenAlex / Crossref / NCBI "polite pools". Put your email here.
CONTACT_EMAIL=student@example.com

# OpenAlex now shares one small anonymous budget per network/IP.
# A FREE key removes that limit: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional FREE key. Raises Semantic Scholar's anonymous ~1 request/second limit.
SEMANTIC_SCHOLAR_API_KEY=

# Optional FREE NCBI key. Raises PubMed's 3 requests/second limit.
NCBI_API_KEY=

# Optional FREE CORE key (open-access aggregator, https://core.ac.uk/services/api).
# Without it, CORE is simply skipped; the other sources still work.
CORE_API_KEY=

# ---------------------------------------------------------------------------
# Optional AI. Used for the "AI relevance note" on top results and for reading
# a long pasted assignment to find its real topic.
#
# With an EMPTY key the app still uses free online AI automatically (see the
# keyless fallback below). Add your own key only if you want a specific model.
#
#   OpenRouter free models : https://openrouter.ai/api/v1
#   Groq free tier         : https://api.groq.com/openai/v1
#   Local Ollama (no key)  : http://localhost:11434/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_ENRICH_NOTES=true
LLM_ENRICH_LIMIT=3
INTERPRET_TOPIC_WITH_LLM=true

# Concept expansion: one primary search plus separate modern, historical,
# per-concept and relationship searches. Raise only if you need more depth.
CONCEPT_SEARCH_MAX_QUERIES=5
CONCEPT_SEARCH_EXTRA_RESULTS=12

# Latency guardrails. CORE is best-effort in normal searches; "Deep search" in
# the UI gives slow repository providers the larger budget.
SEARCH_PROVIDER_TIMEOUT_SECONDS=6
SEARCH_CORE_TIMEOUT_SECONDS=4
SEARCH_DEEP_PROVIDER_TIMEOUT_SECONDS=20
CITATION_BACKFILL_TIMEOUT_SECONDS=2
LLM_NOTE_TIMEOUT_SECONDS=15
LLM_NOTES_API_BUDGET_SECONDS=18

# Keyless free AI (no signup). Set false to force offline-only behaviour.
LLM_KEYLESS_FALLBACK=true
LLM_FALLBACK_URL=https://text.pollinations.ai/openai
LLM_FALLBACK_MODEL=openai

# Search cache lifetime in seconds (results are cached per query + filters).
CACHE_TTL_SECONDS=900

# Module 2 — Source Summarizer. Set false to force the offline extractive
# summary even when an AI provider is available.
SUMMARIZE_WITH_LLM=true
